   <property name="styleSheet">
    <string notr="true">/* =========================================================
   NEO-SKEUO / CLIENT MANAGER
   Qt Widgets QSS
   ========================================================= */

* {
    font-family: &quot;Google Sans&quot;;
    font-size: 13px;
    color: #242424;
}

/* =========================================================
   MAIN WINDOW
   ========================================================= */

QWidget {
    background: #eeeae1;
}

QMainWindow,
QWidget#centralWidget {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,
            stop: 0 #f5f2eb,
            stop: 1 #e5e1d8
        );
}

/* =========================================================
   LABELS
   ========================================================= */

QLabel {
    background: transparent;
    color: #292929;
    padding: 2px 3px;
}

QLabel:hover {
    color: #111111;
}

/* IP / PORT / USERNAME labels */
QLabel#ipLabel,
QLabel#portLabel,
QLabel#usernameLabel {
    font-weight: 500;
    color: #333333;
}

/* =========================================================
   LIST
   ========================================================= */

QListWidget {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,
            stop: 0 #faf9f5,
            stop: 1 #eeeae2
        );

    border: 1px solid #858585;
    border-radius: 2px;

    padding: 6px;

    outline: none;

    /* subtle inset-like shadow */
    selection-background-color: #d9d5cc;
    selection-color: #171717;
}

QListWidget::item {
    background: transparent;

    border: 1px solid transparent;
    border-radius: 3px;

    padding: 3px 4px;
    margin: 1px 0;
}

QListWidget::item:hover {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,
            stop: 0 #f4f2ed,
            stop: 1 #dedbd3
        );

    border: 1px solid #b7b3aa;
}

QListWidget::item:selected {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,
            stop: 0 #e5e1d8,
            stop: 1 #cbc7be
        );

    color: #111111;

    border: 1px solid #9b978e;
}

/* =========================================================
   LINE EDIT
   ========================================================= */

QLineEdit {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,
            stop: 0 #ffffff,
            stop: 0.08 #fafafa,
            stop: 1 #ebe9e4
        );

    border: 1px solid #858585;
    border-radius: 2px;

    padding: 5px 7px;

    selection-background-color: #c9c5bc;
    selection-color: #111111;
}

QLineEdit:hover {
    border: 1px solid #686868;
}

QLineEdit:focus {
    background: #ffffff;
    border: 1px solid #555555;
}

/* Placeholder */
QLineEdit[placeholderText] {
    color: #77736c;
}

/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,

            stop: 0 #faf9f5,
            stop: 0.45 #e9e6df,
            stop: 0.55 #dedbd3,
            stop: 1 #c9c5bc
        );

    border: 1px solid #77746d;
    border-radius: 3px;

    padding: 5px 14px;

    color: #252525;

    min-height: 18px;
}

QPushButton:hover {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,

            stop: 0 #ffffff,
            stop: 0.45 #f0eee9,
            stop: 0.55 #e4e1da,
            stop: 1 #d2cfc7
        );

    border: 1px solid #555555;
}

QPushButton:pressed {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,

            stop: 0 #c6c2b9,
            stop: 0.5 #d1cec6,
            stop: 1 #e3e0d9
        );

    border: 1px solid #555555;

    padding-top: 6px;
    padding-bottom: 4px;
}

QPushButton:disabled {
    background: #dedbd4;
    color: #99958e;
    border: 1px solid #aaa69e;
}

/* =========================================================
   SEND BUTTON
   ========================================================= */

QPushButton#sendButton {
    min-width: 55px;
}

/* =========================================================
   CONNECT BUTTON
   ========================================================= */

QPushButton#connectButton {
    min-height: 20px;
    font-weight: 500;
}

QPushButton#connectButton:hover {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,

            stop: 0 #ffffff,
            stop: 0.5 #eae7e0,
            stop: 1 #d0ccc4
        );
}

/* =========================================================
   GROUPBOX
   ========================================================= */

QGroupBox {
    background: transparent;

    border: 1px solid #aaa69d;
    border-radius: 4px;

    margin-top: 10px;
    padding: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;

    padding: 0 5px;

    background: #eeeae1;
    color: #4b4945;
}

/* =========================================================
   SCROLL BAR
   ========================================================= */

QScrollBar:vertical {
    background: #e1ded6;

    width: 13px;

    border: 1px solid #aaa69f;
    border-radius: 3px;

    margin: 1px;
}

QScrollBar::handle:vertical {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 1, y2: 0,

            stop: 0 #d3d0c8,
            stop: 0.5 #eeeae4,
            stop: 1 #c2beb6
        );

    border: 1px solid #8e8a82;
    border-radius: 3px;

    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #d4d1c9;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* =========================================================
   HORIZONTAL SCROLLBAR
   ========================================================= */

QScrollBar:horizontal {
    background: #e1ded6;

    height: 13px;

    border: 1px solid #aaa69f;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background:
        qlineargradient(
            x1: 0, y1: 0,
            x2: 0, y2: 1,

            stop: 0 #eeeae4,
            stop: 0.5 #d3d0c8,
            stop: 1 #c2beb6
        );

    border: 1px solid #8e8a82;
    border-radius: 3px;

    min-width: 30px;
}

/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background: #f5f2eb;
    color: #222222;

    border: 1px solid #77736c;
    border-radius: 2px;

    padding: 4px 6px;
}</string>
