    <property name="styleSheet">
     <string notr="true">/* Главный контейнер */
QFrame {
    background-color: #12110f; /* Сделаем чуть темнее для лучшего контраста */
    border: 1px solid #ffb000;
    border-radius: 0px;
    font-family: &quot;Courier New&quot;, &quot;Lucida Console&quot;, monospace;
}

/* Подписи — УБИРАЕМ РАМКУ (border: none) */
QLabel {
    color: #ffb000;
    font-size: 13px;
    background: transparent;
    border: none; /* Убирает ненужные рамки вокруг текста подписей */
    padding: 2px 0px;
}

/* Поля ввода */
QLineEdit {
    background-color: #1a1815; 
    border: 1px solid #c88a00;
    color: #ffb000;
    padding: 4px;
    font-size: 14px;
    font-family: &quot;Courier New&quot;, &quot;Lucida Console&quot;, monospace;
    selection-background-color: #ffb000;
    selection-color: #12110f;
}

QLineEdit:focus {
    border: 1px solid #ffb000;
}

/* Кнопка — ПРИНУДИТЕЛЬНО ЗАДАЕМ МОНОШИРИННЫЙ ШРИФТ */
QPushButton {
    background-color: #ffb000;  /* Сделаем её залитой по умолчанию, как у вас */
    border: 1px solid #ffb000;
    color: #12110f;             /* Темный текст на оранжевом фоне */
    padding: 6px;
    font-size: 13px;
    font-weight: bold;
    font-family: &quot;Courier New&quot;, &quot;Lucida Console&quot;, monospace; /* Исправляет шрифт */
}

QPushButton:hover {
    background-color: #e09b00;
    border-color: #e09b00;
}

QPushButton:pressed {
    background-color: #12110f;  /* Инверсия при клике */
    color: #ffb000;
}
</string>
