from PySide6.QtCore import (QCoreApplication, QDate, QDateTime, QLocale,
    QMetaObject, QObject, QPoint, QRect,
    QSize, QTime, QUrl, Qt, QTimer, )
from PySide6.QtGui import (QBrush, QColor, QConicalGradient, QCursor,
    QFont, QFontDatabase, QGradient, QIcon,
    QImage, QKeySequence, QLinearGradient, QPainter,
    QPalette, QPixmap, QRadialGradient, QTransform)
from PySide6.QtWidgets import (QApplication, QHBoxLayout, QLabel, QLineEdit,
    QListWidget, QListWidgetItem, QMainWindow, QPushButton,
    QSizePolicy, QVBoxLayout, QWidget)

import server_ui
import socket

#-----------------UI-----------------

# Execute Qt Window
class ServerWindow(QMainWindow, server_ui.Ui_MainWindow):
    def __init__(self):
        super().__init__()
        self.setupUi(self)
        self.timer = QTimer(self)
        self.setWindowTitle("Server manager 1.0")
    def connectSlots(self):
        self.run_button.clicked.connect(self.runButton)

    @staticmethod
    def executeWindow():
        global server_window
        server_window = ServerWindow()
        server_window.connectSlots()
        server_window.show()

    def runButton(self):
        user_count = int(self.users_count.text())
        try:
            if not 5 > user_count > 0:
                raise ValueError("Users count: 1-4")
            
            main_socket.bind(('0.0.0.0', int(self.port.text())))

        except Exception as e:
            self.out(str(f"Bind: {e}"))
        else:
            main_socket.listen(user_count)
            user_connect_waiting(user_count)
            self.setting_frame.setVisible(False)
            self.close()
            #self.out('Server is started!')
            print('Server is started!')
            #self.timer.timeout.connect(receiving_sending_loop)
            #self.timer.start(1000)
            receiving_sending_loop()
    def out(self, msg: str):
        self.listWidget.addItem(msg)
    
# Execute Qt Window

#-----------------UI-----------------


#--------------Server--------------
def user_connect_waiting(user_count: int):
    global clients

    clients = []

    for x in range(user_count):
        client, addr = main_socket.accept()
        clients.append(client)

def receiving_sending_loop():
    server_window.out("Starting receiving-sending loop")
    while True:
        for client in clients:
            data=client.recv(1024)
            if data:
                data = data.decode("utf-8").split('%%')
                send_data = f"{data[0]} : {data[1]}"
                #server_window.out(send_data)
                client.send(send_data.encode('utf-8'))
            

#--------------Server--------------
def main():
    global main_socket
    app = QApplication()
    ServerWindow.executeWindow()
    main_socket = socket.socket()
    app.exec()
if __name__ == "__main__":
    main()