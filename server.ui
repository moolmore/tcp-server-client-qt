    <property name="styleSheet">
     <string notr="true">/* Стиль для самого виджета списка (окно терминала) */
QListWidget, QListView {
    background-color: #1a0f02;       /* Очень темный, почти черный фон с теплым оттенком */
    border: 2px solid #3d2406;        /* Темно-янтарная тонкая рамка вокруг */
    color: #ffaa00;                  /* Основной янтарно-оранжевый цвет текста (как в neofetch) */
    font-family: &quot;Courier New&quot;, &quot;Lucida Console&quot;, &quot;Consolas&quot;, monospace; /* Моноширинный шрифт */
    font-size: 16px;
    outline: none;                   /* Убирает пунктирную рамку фокуса Qt */
}

/* Настройка полосы прокрутки, чтобы она не портила ретро-вид */
QScrollBar:vertical {
    border: none;
    background: #1a0f02;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #54340a;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}

/* Универсальный стиль для элементов во всех состояниях (обычное, наведение, выбор) */
QListWidget::item, 
QListWidget::item:hover, 
QListWidget::item:disabled,
QListWidget::item:selected, 
QListWidget::item:selected:active, 
QListWidget::item:selected:!active {
    background: transparent;          /* Никакой подсветки фона при наведении и кликах */
    color: #ffaa00;                   /* Текст всегда остается янтарным */
    border: none;                     /* Никаких рамок вокруг выбранной строки */
    padding: 3px 5px;                 /* Небольшие отступы для имитации строк терминала */
}
</string>
    </property>
